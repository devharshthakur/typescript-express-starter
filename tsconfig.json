{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "alwaysStrict": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$middleware/*": ["./src/middlewares/*"],
      "$services/*": ["./src/services/*"],
      "$routes/*": ["./src/routes/*"],
      "$/*": ["./src/*"]
    }
  }
}
