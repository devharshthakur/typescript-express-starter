{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "resolveJsonModule": true,
    "noEmit": true,
    "alwaysStrict": true,
    "types": ["node"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$middlewares/*": ["./src/middlewares/*"],
      "$services/*": ["./src/services/*"],
      "$routes/*": ["./src/routes/*"],
      "$/*": ["./src/*"]
    }
  },
  "exclude": ["node_modules", "build", ".temp"]
}
