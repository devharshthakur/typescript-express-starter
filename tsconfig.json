{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": "src",
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "#lib/*": ["./src/lib/*"],
      "#middleware/*": ["./src/lib/middleware/*"],
      "#services/*": ["./src/lib/services/*"],
      "#routes/*": ["./src/routes/*"],
      "#/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
