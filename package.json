{
  "name": "express-starter",
  "type": "module",
  "version": "1.2.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "pnpm run build && node build/main.js",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:start": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "deps:update": "bash scripts/update.sh"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.4",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
