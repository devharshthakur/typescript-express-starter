{
  "name": "express-starter",
  "type": "module",
  "version": "1.3.0",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "start": "tsdown && node build/main.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --experimental-cli --write .",
    "format:check": "prettier --experimental-cli --check .",
    "check": "tsc --noEmit && eslint . && prettier --experimental-cli --check . && vitest run",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build",
    "docker:start": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "prepare": "husky",
    "setup": "tsx setup.ts",
    "deps:update": "tsx scripts/update.ts",
    "test:setup": "bash test-setup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "supertest": "^7.2.2",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
